NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional override; the project uses this OSS origin by default.
# An explicitly empty value uses local paths and requires restoring public/images.
NEXT_PUBLIC_IMAGE_BASE_URL=https://altria-blog-images-5225758.oss-cn-hongkong.aliyuncs.com

# Server-only traffic storage. Configure these in the Vercel production environment.
# Never prefix the secret key with NEXT_PUBLIC_ or commit its real value.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role JWT fallback when a new secret key is unavailable:
# SUPABASE_SERVICE_ROLE_KEY=
